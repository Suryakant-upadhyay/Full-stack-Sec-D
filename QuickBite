app.get("/api/items", async (req, res) => {
  try {
    const search = text(req.query.search || "");
    const category = text(req.query.category || "");

    const rows = await all(
      `
      SELECT id, name, price, category, description, isAvailable, createdAt
      FROM menu_items
      WHERE
        (? = ""
          OR LOWER(name) LIKE LOWER(?)
          OR LOWER(description) LIKE LOWER(?))
        AND
        (? = "" OR category = ?)
      ORDER BY id DESC
      `,
      [
        search,
        `%${search}%`,
        `%${search}%`,
        category,
        category
      ]
    );

    res.json(
      rows.map((item) => ({
        ...item,
        isAvailable: !!item.isAvailable
      }))
    );
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to load menu items."
    });
  }
});

app.post("/api/items", async (req, res) => {
  try {
    const name = text(req.body.name);
    const category = text(req.body.category);
    const description = text(req.body.description || "");
    const price = Number(req.body.price);
    const available =
      req.body.isAvailable !== false ? 1 : 0;

    if (
      !name ||
      !category ||
      !Number.isFinite(price) ||
      price <= 0
    ) {
      return res.status(400).json({
        error:
          "Name, category and a positive price are required."
      });
    }

    const result = await run(
      `
      INSERT INTO menu_items
      (name, price, category, description, isAvailable)
      VALUES (?, ?, ?, ?, ?)
      `,
      [
        name,
        price,
        category,
        description,
        available
      ]
    );

    const item = await get(
      "SELECT * FROM menu_items WHERE id = ?",
      [result.lastID]
    );

    res.status(201).json({
      ...item,
      isAvailable: !!item.isAvailable
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to create menu item."
    });
  }
});

app.put("/api/items/:id", async (req, res) => {
  try {
    const id = Number(req.params.id);

    const old = await get(
      "SELECT * FROM menu_items WHERE id = ?",
      [id]
    );

    if (!old) {
      return res.status(404).json({
        error: "Menu item not found."
      });
    }

    const name = text(req.body.name);
    const category = text(req.body.category);
    const description = text(req.body.description || "");
    const price = Number(req.body.price);
    const available =
      req.body.isAvailable !== false ? 1 : 0;

    if (
      !name ||
      !category ||
      !Number.isFinite(price) ||
      price <= 0
    ) {
      return res.status(400).json({
        error:
          "Name, category and a positive price are required."
      });
    }

    await run(
      `
      UPDATE menu_items
      SET name = ?, price = ?, category = ?,
          description = ?, isAvailable = ?
      WHERE id = ?
      `,
      [
        name,
        price,
        category,
        description,
        available,
        id
      ]
    );

    const item = await get(
      "SELECT * FROM menu_items WHERE id = ?",
      [id]
    );

    res.json({
      ...item,
      isAvailable: !!item.isAvailable
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to update menu item."
    });
  }
});

app.delete("/api/items/:id", async (req, res) => {
  try {
    const id = Number(req.params.id);

    const result = await run(
      "DELETE FROM menu_items WHERE id = ?",
      [id]
    );

    if (!result.changes) {
      return res.status(404).json({
        error: "Menu item not found."
      });
    }

    res.json({
      message: "Menu item deleted."
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to delete menu item."
    });
  }
});

app.post("/api/orders", async (req, res) => {
  try {
    const customerName = text(req.body.customerName);
    const phone = text(req.body.phone);
    const address = text(req.body.address);

    const incoming = Array.isArray(req.body.items)
      ? req.body.items
      : [];

    if (
      !customerName ||
      !/^\d{10}$/.test(phone) ||
      !address ||
      !incoming.length
    ) {
      return res.status(400).json({
        error:
          "Name, 10-digit phone, address and at least one item are required."
      });
    }

    const items = [];
    let total = 0;

    for (const incomingItem of incoming) {
      const itemId = Number(incomingItem.itemId);
      const qty = Number(incomingItem.qty);

      if (!Number.isInteger(qty) || qty < 1) {
        return res.status(400).json({
          error:
            "Each item quantity must be at least 1."
        });
      }

      const item = await get(
        `
        SELECT id, name, price, isAvailable
        FROM menu_items
        WHERE id = ?
        `,
        [itemId]
      );

      if (!item) {
        return res.status(400).json({
          error: `Item ${itemId} does not exist.`
        });
      }

      if (!item.isAvailable) {
        return res.status(400).json({
          error:
            `${item.name} is currently unavailable.`
        });
      }

      items.push({
        itemId: item.id,
        name: item.name,
        price: Number(item.price),
        qty
      });

      total += Number(item.price) * qty;
    }

    const result = await run(
      `
      INSERT INTO orders
      (customerName, phone, address, items, totalAmount, status)
      VALUES (?, ?, ?, ?, ?, "Placed")
      `,
      [
        customerName,
        phone,
        address,
        JSON.stringify(items),
        total
      ]
    );

    const order = await get(
      "SELECT * FROM orders WHERE id = ?",
      [result.lastID]
    );

    res.status(201).json(serial(order));
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to place order."
    });
  }
});

app.get("/api/orders", async (_req, res) => {
  try {
    const rows = await all(
      `
      SELECT *
      FROM orders
      ORDER BY datetime(createdAt) DESC, id DESC
      `
    );

    res.json(rows.map(serial));
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to load orders."
    });
  }
});

app.patch("/api/orders/:id/status", async (req, res) => {
  try {
    const id = Number(req.params.id);
    const next = text(req.body.status);

    const order = await get(
      "SELECT * FROM orders WHERE id = ?",
      [id]
    );

    if (!order) {
      return res.status(404).json({
        error: "Order not found."
      });
    }

    if (!VALID_STATUSES.includes(next)) {
      return res.status(400).json({
        error: "Invalid order status."
      });
    }

    if (next === "Cancelled") {
      if (order.status !== "Placed") {
        return res.status(400).json({
          error:
            "An order can only be cancelled while it is Placed."
        });
      }
    } else {
      const currentIndex = FLOW.indexOf(order.status);
      const nextIndex = FLOW.indexOf(next);

      if (
        currentIndex < 0 ||
        nextIndex !== currentIndex + 1
      ) {
        return res.status(400).json({
          error:
            "Order status must move forward one step at a time."
        });
      }
    }

    await run(
      "UPDATE orders SET status = ? WHERE id = ?",
      [next, id]
    );

    const updated = await get(
      "SELECT * FROM orders WHERE id = ?",
      [id]
    );

    res.json(serial(updated));
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Unable to update order status."
    });
  }
});

function serial(row) {
  return {
    id: row.id,
    customerName: row.customerName,
    phone: row.phone,
    address: row.address,
    items: JSON.parse(row.items),
    totalAmount: Number(row.totalAmount),
    status: row.status,
    createdAt: row.createdAt
  };
}

app.get("*", (_req, res) => {
  res.sendFile(
    path.join(__dirname, "public", "index.html")
  );
});

init()
  .then(() => {
    app.listen(PORT, () => {
      console.log(
        `QuickBite running on http://localhost:${PORT}`
      );
    });
  })
  .catch((error) => {
    console.error("DB init failed", error);
    process.exit(1);
  });
